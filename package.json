{
  "name": "amo-bot-panel",
  "private": true,
  "description": "AmoBot's React panels — the owner's and an agent's (built to public/admin, public/agent and public/assets)",
  "license": "MIT",
  "homepage": "https://github.com/amir-aghajani/amo-bot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amir-aghajani/amo-bot.git"
  },
  "bugs": {
    "url": "https://github.com/amir-aghajani/amo-bot/issues"
  },
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint --deny-warnings resources/panel/src",
    "format": "prettier --write \"resources/panel/src/**/*.{ts,tsx,css}\" \"resources/panel/*/index.html\" vite.config.ts \"scripts/*.mjs\" knip.jsonc .oxlintrc.json",
    "format:check": "prettier --check \"resources/panel/src/**/*.{ts,tsx,css}\" \"resources/panel/*/index.html\" vite.config.ts \"scripts/*.mjs\" knip.jsonc .oxlintrc.json",
    "api:types": "node scripts/api-types.mjs",
    "test": "vitest run",
    "knip": "knip",
    "check": "node scripts/api-types.mjs --check && pnpm typecheck && pnpm lint && pnpm knip && pnpm format:check && pnpm test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lottie-web": "^5.13.0",
    "lucide-react": "^1.46.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "happy-dom": "^20.14.5",
    "knip": "^6.39.0",
    "oxlint": "^1.83.0",
    "prettier": "^3.9.7",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
