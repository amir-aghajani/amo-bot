// knip (`pnpm knip`, in `pnpm check`): the panels' files, exports, types and dependencies that nothing uses. Its entries
// are its own reading of vite.config.ts — both panels' pages and what they load —, the unit tests and package.json's
// scripts; a test counts as a caller.
{
  "$schema": "./node_modules/knip/schema-jsonc.json",
  "project": ["resources/panel/src/**/*.{ts,tsx,css}", "scripts/*.mjs"],
  "vitest": {
    // Vitest reads its setup files from Vite's root (resources/panel); knip reads them from here.
    "entry": ["resources/panel/src/**/*.test.{ts,tsx}", "resources/panel/src/test/setup.ts", "resources/panel/src/test/global-setup.ts"],
  },
  "ignoreUnresolved": ["src/test/setup.ts", "src/test/global-setup.ts"],
  // Generated from the API description, a type per schema: one no screen names yet is no dead code.
  "ignoreIssues": { "resources/panel/src/lib/api-types.ts": ["exports", "types"] },
}
